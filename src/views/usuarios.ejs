
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Usuários | TicketTI</title>

    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>

<body>

    <div class="layout">

        <%- include('partials/sidebar', { paginaAtiva: 'usuarios' }) %>

        <main class="main-content">

            <div class="content usuarios-page">

                <div class="page-header">
                    <div>
                        <h1>Usuários</h1>
                        <p>Gerencie os usuários do sistema.</p>
                    </div>

                    <button class="btn-primary" onclick="abrirModal()">
                        <i class="bi bi-plus-lg"></i>
                        Novo usuário
                    </button>
                </div>

                <div class="card">

                    <div class="card-header">
                        <h2>Lista de usuários</h2>
                        <span><%= usuarios.length %> usuários cadastrados</span>
                    </div>

                    <div class="table-responsive">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>E-mail</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% if (usuarios.length === 0) { %>
                                    <tr>
                                        <td colspan="4">Nenhum usuário cadastrado.</td>
                                    </tr>
                                <% } %>

                                <% usuarios.forEach(usuario => { %>
                                    <tr>
                                        <td><%= usuario.id %></td>
                                        <td><%= usuario.nome %></td>
                                        <td><%= usuario.email %></td>

                                        <td>
                                        <button onclick="editarUsuario(this)" data-id="<%= usuario.id %>">
                                         <i class="bi bi-pencil"></i>
                                        </button>

                                        <button onclick="excluirUsuario(this)" data-id="<%= usuario.id %>">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                </div>

            </div>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/js/usuarios.js"></script>

</body>
</html>
