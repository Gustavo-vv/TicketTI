
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chamados | TicketTI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="layout">

        <%- include('partials/sidebar', { paginaAtiva: 'chamados' }) %>

        <main class="main-content">

        <header class="topbar">
            <div>
                <h1>Chamados</h1>
                <p>Gerencie e acompanhe as solicitações de suporte.</p>
            </div>

            <a href="/chamados/novo" class="primary-button">
                + Novo chamado
            </a>
        </header>

        <section class="stats-grid">

            <div class="stat-card">
                <span>Total de chamados</span>
                <h2><%= chamados.length %></h2>
            </div>

            <div class="stat-card">
                <span>Em aberto</span>
                <h2><%= chamados.filter(c => c.status === "ABERTO").length %></h2>
            </div>

            <div class="stat-card">
                <span>Em andamento</span>
                <h2><%= chamados.filter(c => c.status === "EM_ANDAMENTO").length %></h2>
            </div>

            <div class="stat-card">
                <span>Resolvidos</span>
                <h2><%= chamados.filter(c => c.status === "RESOLVIDO").length %></h2>
            </div>

        </section>

        <section class="content-section">

            <div class="section-header">
                <div>
                    <h2>Lista de chamados</h2>
                    <p>Consulte as solicitações cadastradas.</p>
                </div>
            </div>

            <div class="filters">

                <input
                    type="text"
                    id="pesquisaChamado"
                    placeholder="Pesquisar chamado..."
                >

                <select id="filtroStatus">
                    <option value="">Todos os status</option>
                    <option value="ABERTO">Aberto</option>
                    <option value="EM_ANDAMENTO">Em andamento</option>
                    <option value="RESOLVIDO">Resolvido</option>
                </select>

                <select id="filtroPrioridade">
                    <option value="">Todas as prioridades</option>
                    <option value="BAIXA">Baixa</option>
                    <option value="MEDIA">Média</option>
                    <option value="ALTA">Alta</option>
                    <option value="URGENTE">Urgente</option>
                </select>

            </div>

            <div class="table-container">

                <table>
                    <thead>
                        <tr>
                            <th>Chamado</th>
                            <th>Solicitante</th>
                            <th>Categoria</th>
                            <th>Prioridade</th>
                            <th>Status</th>
                            <th>Data</th>
                        </tr>
                    </thead>

                    <tbody id="listaChamados">

                        <% chamados.forEach(chamado => { %>

                            <tr class="linha-chamado"
                                data-status="<%= chamado.status %>"
                                data-prioridade="<%= chamado.prioridade %>">

                                <td>
                                    <strong>#<%= chamado.id %> - <%= chamado.titulo %></strong>
                                    <small><%= chamado.descricao %></small>
                                </td>

                                <td><%= chamado.usuario.nome %></td>

                                <td><%= chamado.categoria.nome %></td>

                                <td>
                                    <span class="badge-prioridade <%= chamado.prioridade.toLowerCase() %>">
                                        <%= chamado.prioridade %>
                                    </span>
                                </td>

                                <td>
                                    <span class="badge-status <%= chamado.status.toLowerCase() %>">
                                        <%= chamado.status.replace("_", " ") %>
                                    </span>
                                </td>

                                <td>
                                    <%= new Date(chamado.criadoEm).toLocaleDateString('pt-BR') %>
                                </td>

                            </tr>

                        <% }) %>

                        <% if (chamados.length === 0) { %>
                            <tr>
                                <td colspan="6" class="empty-message">
                                    Nenhum chamado cadastrado.
                                </td>
                            </tr>
                        <% } %>

                    </tbody>
                </table>

                <p id="semResultado" class="empty-message" hidden>
                    Nenhum chamado encontrado.
                </p>

            </div>

        </section>

    </main>

    <script src="/js/chamados.js"></script>

</body>
</html>
